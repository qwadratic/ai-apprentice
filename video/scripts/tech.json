    {
      "type": "facts",
      "durationSec": 6.5,
      "kicker": "ScreenBridge v1 · vision",
      "title": "One contract for any app",
      "items": [
        {
          "text": "Frames are masked in the browser before upload",
          "atSec": 0.3
        },
        {
          "text": "Vision turns each changed frame into one typed observation",
          "atSec": 1.3
        },
        {
          "text": "Region boxes [x, y, w, h], 0..1, so Clipa can point",
          "atSec": 2.3
        }
      ],
      "code": {
        "title": "screen_activity · its shape (synthetic example)",
        "atSec": 0.8,
        "text": "{\n  \"kind\": \"screen_activity\",\n  \"facts\": {\n    \"app\": \"Demo workspace\",\n    \"surface\": \"Order → email → ticket\",\n    \"summary\": \"The draft to customer_07 has the\n      delivery address and time in the text\n      and the delivery image attached.\",\n    \"change\": \"Address and time copied from\n      the order into the email text.\",\n    \"pendingAction\": \"Send demo email\",\n    \"regions\": [{ \"label\": \"Message\",\n                  \"box\": [0.31, 0.52, 0.42, 0.18] }]\n  }\n}"
      }
    },
    {
      "type": "facts",
      "durationSec": 6.5,
      "kicker": "The Conductor",
      "title": "When Clipa speaks",
      "items": [
        {
          "text": "Never while you type or talk",
          "atSec": 0.3
        },
        {
          "text": "A pause: 1.8 s without typing, talking or a screen change",
          "atSec": 1.2
        },
        {
          "text": "The question is prepared as the screen settles, asked at the pause",
          "atSec": 2.1
        },
        {
          "text": "At least 15 s between questions",
          "atSec": 3
        }
      ]
    },
