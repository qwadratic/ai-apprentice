{
  "description": "A live Show session on the public app with the synthetic sample observations (no screen, no voice). The voice signed-URL request is blocked, so no voice conversation opens and the session runs without voice; Clipa's cues come from the real API and show as text. Opens a real session on the backend; it expires on its own.",
  "url": "https://qwadratic.github.io/clipa/",
  "permissions": ["microphone"],
  "block": ["/api/agent/elevenlabs/", "elevenlabs.io"],
  "steps": [
    { "do": "goto", "ready": { "role": "button", "name": "Start Show" }, "wait": 1500, "marker": "open" },
    { "do": "click", "text": "Options and limits", "wait": 1000, "marker": "options" },
    { "do": "check", "byLabel": "Use sample observations", "wait": 2000, "marker": "sample" },
    { "do": "click", "role": "button", "name": "Start Show", "wait": 45000, "marker": "start" },
    { "do": "wait", "wait": 45000, "marker": "mid" },
    { "do": "click", "role": "button", "name": "Off the record", "wait": 5000, "marker": "off" },
    { "do": "click", "role": "button", "name": "Back on record", "wait": 2500, "marker": "back", "optional": true },
    { "do": "click", "role": "tab", "name": "Reflect", "wait": 25000, "marker": "reflect", "optional": true },
    { "do": "wait", "wait": 1000, "marker": "end" }
  ]
}
