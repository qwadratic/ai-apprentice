# Server only. Load through the deployment EnvironmentFile or shell.
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=/var/lib/apprentice/db/apprentice.sqlite
MEDIA_DIR=/var/lib/apprentice/media
RUNNER_URL=http://127.0.0.1:8787
# RUNNER_TOKEN is supplied privately by TASK-4, never committed or exposed to Vite.
# Build-time web setting for GitHub Pages: WEB_BASE_PATH=/clipa/
# Dev-only target override: API_PROXY_TARGET=http://127.0.0.1:8000
