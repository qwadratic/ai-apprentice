[Unit]
Description=Apprentice deploy of the sha requested through POST /ops/deploy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=apprentice
Group=apprentice
# deploy.sh unsets the secrets before running install or build scripts.
# NoNewPrivileges must stay off: deploy.sh restarts the units through sudo.
EnvironmentFile=/etc/apprentice/env
ExecStart=/opt/apprentice/bin/apprentice-deploy --request
StandardOutput=journal
StandardError=journal
