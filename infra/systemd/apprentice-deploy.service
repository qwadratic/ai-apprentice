[Unit]
Description=Apprentice deploy (pull DEPLOY_REF, install, build, restart, roll back on failure)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=apprentice
Group=apprentice
# Only DEPLOY_REF is used; deploy.sh unsets every other variable from this file.
# NoNewPrivileges must stay off: deploy.sh restarts the units through sudo.
EnvironmentFile=/etc/apprentice/env
ExecStart=/opt/apprentice/infra/deploy/deploy.sh
StandardOutput=journal
StandardError=journal
