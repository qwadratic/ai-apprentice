[Unit]
Description=Apprentice deploy from DEPLOY_SOURCE (pages or ref): manual, or the optional timer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=apprentice
Group=apprentice
# deploy.sh reads DEPLOY_SOURCE, DEPLOY_REF and DEPLOY_JSON_URL and unsets the secrets.
# NoNewPrivileges must stay off: deploy.sh restarts the units through sudo.
EnvironmentFile=/etc/apprentice/env
ExecStart=/opt/apprentice/bin/apprentice-deploy
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal
