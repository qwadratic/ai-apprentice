{
  "name": "@apprentice/agent-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent lab page: TypeScript sources compiled by tsc into dist/ (the whole site).",
  "engines": { "node": ">=22.22" },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p scripts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.ts"
  },
  "devDependencies": {
    "@elevenlabs/client": "1.26.0",
    "@types/node": "^22",
    "typescript": "~7.0.2"
  }
}
